# OpenRouter API
OPENROUTER_API_KEY=

# Neon Postgres (Vercel-native integration)
DATABASE_URL=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Auth.js v5
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Encryption key for MCP OAuth tokens (AES-GCM, 32-byte hex)
TOKEN_ENCRYPTION_KEY=

# mcp-server/ (POC) — only needed when the process is spawned with a cwd
# other than the repo root (e.g. by Claude Desktop). Points at the folder
# containing the *.skill files. See mcp-server/README.md.
SKILLS_ROOT_DIR=

# Free Ahrefs replacement (lib/enrichment/domain-seo.ts) — both optional,
# missing either degrades that one field to null instead of failing.
# Google Cloud API key, no billing required: https://developers.google.com/speed/docs/insights/v5/get-started
GOOGLE_PAGESPEED_API_KEY=
# Requires installing the Keywords Everywhere browser extension to generate
# a key, then signing in at openpagerank.keywordseverywhere.com/dashboard to
# mint an OPR key — deprioritized (2026-09-16), see domain-authority.ts.
OPENPAGERANK_API_KEY=
